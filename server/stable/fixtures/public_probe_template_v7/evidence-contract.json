{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:o03:c021:evidence:v1",
  "schema_version": "o03.template-evidence.v1",
  "$defs": {
    "EvidenceOrigin": {
      "type": "object",
      "properties": {
        "synthetic_only": {
          "const": true
        },
        "origin_kind": {
          "const": "fixture_reviewed_revision"
        },
        "target_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "phase": {
          "enum": [
            "official",
            "corrected"
          ]
        },
        "supersedes_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_material": {
          "type": "object",
          "properties": {
            "synthetic_only": {
              "const": true
            },
            "target_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "phase": {
              "enum": [
                "official",
                "corrected"
              ]
            },
            "participants": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "participant_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "horse_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "reported_finish_position": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "normalized_status": {
                    "enum": [
                      "finished",
                      "disqualified",
                      "dead_heat"
                    ]
                  },
                  "is_confirmed": {
                    "type": "boolean"
                  },
                  "source_order": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "source_horse_number": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "source_horse_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "source_fields": {
                    "type": "object",
                    "properties": {
                      "jockey_name": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "trainer_name": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "finish_time": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "margin": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "odds": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "popularity": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "jockey_name",
                      "trainer_name",
                      "finish_time",
                      "margin",
                      "odds",
                      "popularity"
                    ],
                    "additionalProperties": false
                  },
                  "field_availability": {
                    "type": "object",
                    "properties": {
                      "jockey_name": {
                        "enum": [
                          "available",
                          "known_missing"
                        ]
                      },
                      "trainer_name": {
                        "enum": [
                          "available",
                          "known_missing"
                        ]
                      },
                      "finish_time": {
                        "enum": [
                          "available",
                          "known_missing"
                        ]
                      },
                      "margin": {
                        "enum": [
                          "available",
                          "known_missing"
                        ]
                      },
                      "odds": {
                        "enum": [
                          "available",
                          "known_missing"
                        ]
                      },
                      "popularity": {
                        "enum": [
                          "available",
                          "known_missing"
                        ]
                      }
                    },
                    "required": [
                      "jockey_name",
                      "trainer_name",
                      "finish_time",
                      "margin",
                      "odds",
                      "popularity"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "participant_ref",
                  "horse_ref",
                  "reported_finish_position",
                  "normalized_status",
                  "is_confirmed",
                  "source_order",
                  "source_horse_number",
                  "source_horse_name",
                  "source_fields",
                  "field_availability"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 512
            },
            "source_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "synthetic_only",
            "target_key",
            "phase",
            "participants",
            "source_revision"
          ],
          "additionalProperties": false
        },
        "raw_material_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "participant_proof_refs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxProperties": 512
        },
        "complete_under_fixture_rule_only": {
          "const": true
        },
        "fixture_requirement_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "synthetic_only",
        "origin_kind",
        "target_key",
        "phase",
        "supersedes_ref",
        "raw_material",
        "raw_material_sha256",
        "participant_proof_refs",
        "complete_under_fixture_rule_only",
        "fixture_requirement_ref"
      ],
      "additionalProperties": false
    },
    "EvidencePermission": {
      "type": "object",
      "properties": {
        "synthetic_only": {
          "const": true
        },
        "target_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "origin_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "capability": {
          "enum": [
            "result",
            "correction"
          ]
        },
        "audience_ref": {
          "const": "anonymous"
        },
        "allowed_surfaces": {
          "type": "array",
          "items": {
            "enum": [
              "detail.result-family",
              "calendar.main.result-summary"
            ]
          },
          "minItems": 1,
          "maxItems": 2
        },
        "allowed": {
          "type": "boolean"
        },
        "valid_from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "valid_until": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "proof_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "permission_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "permission_version": {
          "type": "string",
          "pattern": "^pp1:[0-9a-f]{64}$"
        }
      },
      "required": [
        "synthetic_only",
        "target_key",
        "origin_ref",
        "capability",
        "audience_ref",
        "allowed_surfaces",
        "allowed",
        "valid_from",
        "valid_until",
        "proof_ref",
        "permission_generation",
        "permission_version"
      ],
      "additionalProperties": false
    },
    "EvidenceF01": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "f01.v1"
        },
        "evaluated_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "input_version": {
          "$ref": "#/$defs/InputVersion"
        },
        "snapshot": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "evaluated_at",
        "policy_ref",
        "input_version",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "EvidenceMapping": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "c020.approved-display-fixture.v1"
        },
        "synthetic_only": {
          "const": true
        },
        "origin_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "presentation_mode": {
          "enum": [
            "legacy",
            "strict_display_v1"
          ]
        },
        "body_contract_version": {
          "const": "o03.result-template-body.v1"
        },
        "ordered_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "participant_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "cells": {
                "$ref": "#/$defs/Cells"
              }
            },
            "required": [
              "participant_ref",
              "cells"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 512
        },
        "known_missing": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "enum": [
                "position",
                "horse_number",
                "horse_name",
                "jockey_name",
                "trainer_name",
                "finish_time",
                "margin",
                "odds",
                "popularity"
              ]
            },
            "maxItems": 9
          },
          "maxProperties": 512
        },
        "review_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidence_scope": {
          "const": "fixture_only_not_real_resolver_receipt"
        }
      },
      "required": [
        "schema_version",
        "synthetic_only",
        "origin_ref",
        "presentation_mode",
        "body_contract_version",
        "ordered_rows",
        "known_missing",
        "review_ref",
        "evidence_scope"
      ],
      "additionalProperties": false
    },
    "EvidenceDocuments": {
      "type": "object",
      "properties": {
        "origins": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EvidenceOrigin"
          },
          "maxProperties": 8
        },
        "permissions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EvidencePermission"
          },
          "maxProperties": 8
        },
        "f01_documents": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EvidenceF01"
          },
          "maxProperties": 8
        },
        "display_mappings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EvidenceMapping"
          },
          "maxProperties": 8
        }
      },
      "required": [
        "origins",
        "permissions",
        "f01_documents",
        "display_mappings"
      ],
      "additionalProperties": false
    },
    "InputVersion": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "f01.input.v1"
        },
        "scope": {
          "const": [
            "entity",
            "evidence",
            "materials",
            "policy_ref",
            "protection"
          ]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generations": {
          "type": "object",
          "properties": {
            "owner": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "schedule": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "enrollment": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "source_set": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "owner",
            "schedule",
            "enrollment",
            "source_set"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "scope",
        "content_sha256",
        "generations"
      ],
      "additionalProperties": false
    },
    "Cells": {
      "type": "object",
      "properties": {
        "position": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "horse_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "horse_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "jockey_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "trainer_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "finish_time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "margin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "odds": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "popularity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "position",
        "horse_number",
        "horse_name",
        "jockey_name",
        "trainer_name",
        "finish_time",
        "margin",
        "odds",
        "popularity"
      ],
      "additionalProperties": false
    }
  },
  "root": {
    "$ref": "#/$defs/EvidenceDocuments"
  },
  "limits": {
    "wire_bytes": 262144,
    "depth": 64,
    "nodes": 12000,
    "index_members": 8
  },
  "semantic_rules": [
    "全scope refs装配，不从observed marker筛选；四表精确、无外部ref。",
    "原件缺失unverified；多余/重复/冲突/哈希不等不得签receipt。",
    "F01 full input由固定parse_input复验；snapshot不得只传摘要。",
    "全部hash与既有tuple/proof域一致；fixture原件不认证production身份。"
  ]
}
