CRAWL_JOB_STALE_MINUTES=60
CRAWL_JOB_RECONCILE_BATCH_SIZE=100
NEWS_SOURCE_HEALTH_SHORT_WINDOW_HOURS=2
NEWS_SOURCE_HEALTH_LONG_WINDOW_HOURS=24
NEWS_INDEX_P0_COOLDOWN_HOURS=6
