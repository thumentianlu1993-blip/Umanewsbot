# Multi-region news source polling
NEWS_SOURCE_POLL_ENABLED=false
NEWS_SOURCE_POLL_INTERVAL_MINUTES=30
NEWS_SOURCE_POLL_MAX_SOURCES=3
NEWS_SOURCE_POLL_ALLOWED_REGIONS=
NEWS_SOURCE_POLL_ALLOWED_SOURCES=
