# 默认模板按生产环境给出。
# 若本地开发，请改：
# DB_ENGINE=sqlite
# DEBUG=true

# Django
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
SITE_URL=https://your-domain.com
DJANGO_ADMIN_URL=/django-admin/
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# Security / reverse proxy
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
CSRF_COOKIE_HTTPONLY=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
USE_X_FORWARDED_HOST=true
SECURE_HSTS_SECONDS=86400
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# Database (Alibaba Cloud RDS PostgreSQL)
DB_ENGINE=postgres
POSTGRES_DB=horse_news
POSTGRES_USER=horse_news
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=your-rds-endpoint.pg.rds.aliyuncs.com
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_SSLMODE=prefer

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ALWAYS_EAGER=false
AUTO_TRANSLATE_ON_INGEST=true
AUTO_TRANSLATE_SYNC=true

# Translation
TRANSLATION_PROVIDER=siliconflow
TRANSLATION_MODEL=deepseek-ai/DeepSeek-V3
OPENAI_API_KEY=
OPENAI_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
TRANSLATION_TIMEOUT_SECONDS=90
TRANSLATION_MAX_TOKENS=2400
TRANSLATION_MAX_ATTEMPTS=2
TRANSLATION_UNKNOWN_HORSE_LIMIT=12
TRANSLATION_TERM_LIMIT=20

# Alibaba Cloud OSS media storage
MEDIA_STORAGE_BACKEND=oss
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=your-oss-bucket
OSS_ENDPOINT=https://oss-hk.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://your-oss-bucket.oss-hk.aliyuncs.com
OSS_MEDIA_PREFIX=media
OSS_BACKUP_PREFIX=db_backups

# QQ / OneBot
ONEBOT_BASE_URL=http://onebot:3000
ONEBOT_ACCESS_TOKEN=

# Gunicorn / container runtime
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Optional bootstrap admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Backup behavior
BACKUP_DIR=./backups/db
BACKUP_TARGET=local
