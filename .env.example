MULTIREGION_PRODUCTION_WINDOW_LEASE_MINUTES=30
MULTIREGION_CRAWL_DEFAULT_INTERVAL_MINUTES=15
MULTIREGION_CRAWL_MAJOR_RACE_INTERVAL_MINUTES=5
MULTIREGION_CRAWL_MAX_SOURCES_PER_TICK=50
MULTIREGION_CRAWL_FAILURES_TO_BACKOFF=3
MULTIREGION_CRAWL_SUCCESSES_TO_RECOVER=3
