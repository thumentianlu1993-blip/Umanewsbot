# 默认模板按生产环境给出。
# 若本地开发，请改：
# DB_ENGINE=sqlite
# SQLITE_DB_PATH=/tmp/umanews-local.sqlite3
# DEBUG=true

# Django
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://your-domain.com,http://www.your-domain.com,https://your-domain.com,https://www.your-domain.com
SITE_URL=http://your-domain.com
DJANGO_ADMIN_URL=/django-admin/
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# Security / reverse proxy
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
CSRF_COOKIE_HTTPONLY=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
USE_X_FORWARDED_HOST=true
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Database (Alibaba Cloud RDS PostgreSQL)
DB_ENGINE=postgres
POSTGRES_DB=horse_news
POSTGRES_USER=horse_news
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=your-rds-endpoint.pg.rds.aliyuncs.com
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_SSLMODE=prefer

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ALWAYS_EAGER=false
AUTO_TRANSLATE_ON_INGEST=true
AUTO_TRANSLATE_SYNC=true

# Translation
TRANSLATION_PROVIDER=siliconflow
TRANSLATION_MODEL=deepseek-ai/DeepSeek-V3
OPENAI_API_KEY=
OPENAI_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
TRANSLATION_TIMEOUT_SECONDS=90
TRANSLATION_MAX_TOKENS=2400
TRANSLATION_MAX_ATTEMPTS=2
TRANSLATION_UNKNOWN_HORSE_LIMIT=12
TRANSLATION_TERM_LIMIT=20

# Automation / AI editorial rewriting
AUTOMATION_ENABLED=false
AUTO_REVIEW_THRESHOLD=75
MANUAL_REVIEW_THRESHOLD=45
AUTO_REWRITE_ENABLED=false
AUTO_PUBLISH_CONTENT_SOURCE=base_translation
HIGH_VALUE_SOURCE_RULES=netkeiba:access,netkeiba:attention
HIGH_VALUE_WARNING_SCORE_THRESHOLD=90
AUTO_DUPLICATE_LOOKBACK_DAYS=7
AUTO_DUPLICATE_HIGH_THRESHOLD=0.86
AUTO_DUPLICATE_REVIEW_THRESHOLD=0.72
AUTO_PUBLISH_BATCH_LIMIT=4
AUTO_PUBLISH_PEAK_BATCH_LIMIT=10
AUTO_PUBLISH_PEAK_DAY_OF_WEEK=6
AUTO_PUBLISH_PEAK_START_HOUR=13
AUTO_PUBLISH_PEAK_END_HOUR=16
AUTO_PUBLISH_INTERVAL_MINUTES=15
REWRITE_CONFIDENCE_MIN=60
AUTO_PUBLISH_REQUIRE_COVER=false
REWRITE_PROVIDER=siliconflow
REWRITE_MODEL=deepseek-ai/DeepSeek-V3
REWRITE_MAX_TOKENS=2600
REWRITE_TIMEOUT_SECONDS=120

# 专有术语候选发现
TERM_DISCOVERY_ENABLED=false
TERM_DISCOVERY_PROVIDER=rules
TERM_DISCOVERY_MIN_CONFIDENCE=60

# 外部赛马数据离线导入
EXTERNAL_HORSE_DATA_IMPORT_ENABLED=false
EXTERNAL_HORSE_DATA_ALLOW_NETWORK=false
EXTERNAL_HORSE_DATA_LOOKBACK_MONTHS=24
EXTERNAL_HORSE_DATA_REQUEST_INTERVAL_SECONDS=5
EXTERNAL_HORSE_DATA_JITTER_SECONDS=2
EXTERNAL_HORSE_DATA_MAX_RACES_PER_RUN=30
EXTERNAL_HORSE_DATA_MAX_HORSES_PER_RUN=100
EXTERNAL_HORSE_DATA_FETCH_ODDS=false
EXTERNAL_HORSE_DATA_FETCH_HORSE_DETAIL=true

# Automation notifications (email is the first real channel in MVP)
AUTOMATION_ENABLE_EMAIL=false
AUTOMATION_NOTIFY_EMAILS=
AUTOMATION_WARNING_EMAIL_ENABLED=true
AUTOMATION_WARNING_NOTIFY_EMAILS=754652181@qq.com
AUTOMATION_WARNING_EMAIL_DEDUP_HOURS=24
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=umanewsbot@example.com

# Alibaba Cloud OSS media storage
MEDIA_STORAGE_BACKEND=oss
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=your-oss-bucket
OSS_ENDPOINT=https://oss-hk.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://your-oss-bucket.oss-hk.aliyuncs.com
OSS_MEDIA_PREFIX=media
OSS_BACKUP_PREFIX=db_backups

# QQ / OneBot
ONEBOT_BASE_URL=http://onebot:3000
ONEBOT_ACCESS_TOKEN=

# Gunicorn / container runtime
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Optional bootstrap admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Backup behavior
BACKUP_DIR=./backups/db
BACKUP_TARGET=local
