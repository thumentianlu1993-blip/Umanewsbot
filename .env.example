# 默认模板按生产环境给出。
# 若本地开发，请改：
# DB_ENGINE=sqlite
# SQLITE_DB_PATH=/tmp/umanews-local.sqlite3
# DEBUG=true

# Django
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://your-domain.com,http://www.your-domain.com,https://your-domain.com,https://www.your-domain.com
SITE_URL=http://your-domain.com
DJANGO_ADMIN_URL=/django-admin/
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# Security / reverse proxy
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
CSRF_COOKIE_HTTPONLY=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
USE_X_FORWARDED_HOST=true
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Database (Alibaba Cloud RDS PostgreSQL)
DB_ENGINE=postgres
POSTGRES_DB=horse_news
POSTGRES_USER=horse_news
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=your-rds-endpoint.pg.rds.aliyuncs.com
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_SSLMODE=prefer
# 独立 runner phase env 必须设置为 umanews-historical-runner:<run_id>:<phase>。
POSTGRES_APPLICATION_NAME=

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ALWAYS_EAGER=false
AUTO_TRANSLATE_ON_INGEST=true
AUTO_TRANSLATE_SYNC=true

# 准实时赛果独立 worker（默认不启用调度）
RACE_LIVE_SCHEDULER_ENABLED=false
RACE_LIVE_MONITOR_ENABLED=false
RACE_LIVE_ENABLED_REGIONS=
RACE_LIVE_CLAIM_TTL_SECONDS=240
RACE_LIVE_RUNNER_MODE=disabled
RACE_LIVE_OFFLINE_FIXTURE_ROOT=
RACE_LIVE_RACECARD_ARTIFACT_ROOT=/run/race-live/racecards
RACE_LIVE_PUBLICATION_ARTIFACT_ROOT=/run/race-live/publications
RACE_LIVE_TRA_SECRET_ENV_FILE=
RACE_LIVE_TRA_REGISTRY_FILE=/app/runtime/policies/race_live/source_registry_the_racing_api_free.json
RACE_LIVE_TRA_REGISTRY_SHA256=7aca49ff1df7573ebfe6a9e403eefca5c9e64d8ee18d8d3be383d67803db550a
RACE_LIVE_RESULTS_FETCH_BUDGET_SECONDS=165
CELERY_RACE_LIVE_WORKER_CONCURRENCY=1
CELERY_RACE_LIVE_WORKER_SOFT_TIME_LIMIT=180
CELERY_RACE_LIVE_WORKER_TIME_LIMIT=210
RACE_LIVE_WORKER_CPUS=0.25
RACE_LIVE_WORKER_MEMORY_LIMIT=384M

# Translation
TRANSLATION_PROVIDER=siliconflow
TRANSLATION_MODEL=deepseek-ai/DeepSeek-V3
OPENAI_API_KEY=
OPENAI_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
TRANSLATION_TIMEOUT_SECONDS=90
TRANSLATION_MAX_TOKENS=2400
TRANSLATION_MAX_ATTEMPTS=3
TRANSLATION_UNKNOWN_HORSE_LIMIT=12
TRANSLATION_TERM_LIMIT=20

# Automation / AI editorial rewriting
AUTOMATION_ENABLED=false
AUTO_REVIEW_THRESHOLD=75
MANUAL_REVIEW_THRESHOLD=45
AUTO_REWRITE_ENABLED=false
AUTO_PUBLISH_CONTENT_SOURCE=base_translation
HIGH_VALUE_SOURCE_RULES=netkeiba:access,netkeiba:attention
