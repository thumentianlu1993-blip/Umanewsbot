# Gunicorn / container runtime
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Optional bootstrap admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Backup behavior
BACKUP_DIR=./backups/db
BACKUP_TARGET=local
# Historical graded/pattern race inventory and backfill. Keep both switches off until an approved run.
HISTORICAL_RACE_BACKFILL_ENABLED=false
HISTORICAL_RACE_BACKFILL_ALLOW_NETWORK=false
HISTORICAL_RACE_BACKFILL_REQUEST_BUDGET=250
HISTORICAL_RACE_BACKFILL_MAX_SOURCE_CACHE_BYTES=2147483648
HISTORICAL_RACE_BACKFILL_MIN_FREE_DISK_BYTES=5368709120
# 独立历史 runner 只读取单独的 0600 phase env/owner token 文件，不复用本文件中的外部 API 密钥。
HISTORICAL_RUNNER_CONTAINER_NAME=umanews-historical-runner
HISTORICAL_RUNNER_INTERNAL_NETWORK=umanews-historical-runner-db
HISTORICAL_RUNNER_EGRESS_NETWORK=umanews-historical-runner-egress
HISTORICAL_RUNNER_SECRET_DIR=/opt/umanewsbot/runtime/historical_runner_secrets
# 宿主启动脚本必须显式指定 apply phase 使用的既有业务写入角色。
HISTORICAL_RUNNER_APPLY_ROLE=horse_news
HISTORICAL_RUNNER_PAUSE_TIMEOUT_SECONDS=300
# 仅首次创建 runner 三表的部署命令临时设置 true；成功后立即恢复 false。
HISTORICAL_RUNNER_INITIAL_INSTALL=false
RACE_EVENT_PUBLIC_CACHE_SECONDS=300
RACE_EVENT_CACHE_URL=redis://redis:6379/2
HORSE_PROFILE_COMPLETION_REGION_BATCH_LIMIT=100
HORSE_PROFILE_COMPLETION_TOTAL_BATCH_LIMIT=500
HORSE_PROFILE_COMPLETION_BATCH_STATE_DIR=runtime/horse_profile_completion/batches
HORSE_PROFILE_COMPLETION_REVIEW_OUTPUT_DIR=runtime/horse_profile_completion/review
HORSE_PROFILE_COMPLETION_MAX_REQUESTS=0
HORSE_PROFILE_COMPLETION_RETRY_MAX_ATTEMPTS=3
HORSE_PROFILE_COMPLETION_RETRY_BACKOFF_BASE_SECONDS=30
HORSE_PROFILE_COMPLETION_BUDGET_DIR=runtime/horse_profile_completion/budget
