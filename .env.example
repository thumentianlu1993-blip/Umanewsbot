MULTIREGION_QQ_SITE_HOURLY_MAX_DAILY=40
MULTIREGION_QQ_SITE_HOURLY_MAX_MAJOR_RACE=80
MULTIREGION_OPS_NOTIFICATIONS_ENABLED=false
MULTIREGION_OPS_NOTIFICATION_QQ_GROUP_ID=
MULTIREGION_OPS_NOTIFICATION_EMAILS=
MULTIREGION_OPS_NOTIFICATION_COOLDOWN_MINUTES=30
# 回滚开关：紧急时可只关闭某一条链路。
MULTIREGION_ROLLBACK_DISABLE_CRAWL_WINDOWS=false
MULTIREGION_ROLLBACK_DISABLE_PUBLISH_WINDOWS=false
