HISTORICAL_RUNNER_APPLY_ROLE=horse_news
HISTORICAL_RUNNER_PAUSE_TIMEOUT_SECONDS=300
# 仅首次创建 runner 三表的部署命令临时设置 true；成功后立即恢复 false。
HISTORICAL_RUNNER_INITIAL_INSTALL=false
# 赛事与马匹履历字段规范化（默认关闭）
RACE_FIELD_NORMALIZED_DISPLAY_ENABLED=false
RACE_FIELD_NORMALIZED_STATS_ENABLED=false
RACE_EVENT_PUBLIC_CACHE_SECONDS=300
RACE_EVENT_CACHE_URL=redis://redis:6379/2
HORSE_PROFILE_COMPLETION_REGION_BATCH_LIMIT=100
HORSE_PROFILE_COMPLETION_TOTAL_BATCH_LIMIT=500
HORSE_PROFILE_COMPLETION_BATCH_STATE_DIR=runtime/horse_profile_completion/batches
HORSE_PROFILE_COMPLETION_REVIEW_OUTPUT_DIR=runtime/horse_profile_completion/review
HORSE_PROFILE_COMPLETION_MAX_REQUESTS=0
HORSE_PROFILE_COMPLETION_RETRY_MAX_ATTEMPTS=3
HORSE_PROFILE_COMPLETION_RETRY_BACKOFF_BASE_SECONDS=30
HORSE_PROFILE_COMPLETION_BUDGET_DIR=runtime/horse_profile_completion/budget
# 多语言赛马术语统一与公开内容修复（默认关闭）
TERM_CONSISTENCY_ENABLED=false
TERM_CONSISTENCY_SHADOW=true
TERM_CONSISTENCY_ENFORCE=false

# 赛事新闻聚类与首页/QQ 曝光治理（默认关闭）
RACE_NEWS_EXPOSURE_ENABLED=false
RACE_NEWS_EXPOSURE_SHADOW=true
RACE_NEWS_SECOND_SLOT_DELAY_MINUTES=15
RACE_NEWS_HOMEPAGE_MAX=2
RACE_NEWS_QQ_TARGET_MAX=2
